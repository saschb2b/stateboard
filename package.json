{
  "name": "stateboard",
  "version": "2026.7.0",
  "private": true,
  "description": "Status reporting for visual products. Show, don't tell.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.test.ts\" \"scripts/**/*.test.mjs\"",
    "build:pages": "node scripts/pages-prebuild.mjs && STATEBOARD_PAGES=1 next build",
    "migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "better-auth": "^1.6.25",
    "fumadocs-core": "^16.9.3",
    "fumadocs-mdx": "^15.0.13",
    "fumadocs-ui": "^16.9.3",
    "nanoid": "^5.1.16",
    "next": "16.2.12",
    "pg": "^8.21.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^25.9.2",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.23",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.61.0"
  },
  "packageManager": "pnpm@10.20.0",
  "pnpm": {
    "overrides": {
      "next>postcss": "^8.5.15"
    }
  }
}
