{
  "name": "stateboard",
  "version": "2026.10.0",
  "private": true,
  "description": "Release readiness for every role.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build && node scripts/standalone-artifact.mjs --remove-env && node scripts/standalone-artifact.mjs",
    "build:check": "node scripts/standalone-artifact.mjs",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.test.ts\" \"scripts/**/*.test.mjs\"",
    "test:stories": "vitest --project storybook run",
    "build:pages": "node scripts/pages-prebuild.mjs && STATEBOARD_PAGES=1 next build",
    "migrate": "node scripts/migrate.mjs",
    "cleanup:release-assets": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/cleanup-release-assets.mjs",
    "test:integration": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/release-db.test.mjs scripts/mcp-release.test.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "browser": "agent-browser",
    "browser:install": "agent-browser install",
    "design:generate": "node scripts/design-tokens.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "i18n:check": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "better-auth": "^1.7.12",
    "fumadocs-core": "^16.15.9",
    "fumadocs-mdx": "^15.4.9",
    "fumadocs-ui": "^16.15.9",
    "nanoid": "^6.0.2",
    "next": "16.3.5",
    "next-intl": "^4.14.9",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@formatjs/icu-messageformat-parser": "^3.5.22",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/nextjs-vite": "^10.6.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "agent-browser": "0.39.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.6.3",
    "playwright": "^1.62.1",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "storybook": "^10.6.3",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.10",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@10.20.0",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "agent-browser"
    ],
    "overrides": {
      "next>postcss": "^8.5.15"
    }
  }
}
