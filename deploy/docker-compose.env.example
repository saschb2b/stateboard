# Copy to deploy/.env and fill in. Used by deploy/docker-compose.yaml.
#
#   cp deploy/docker-compose.env.example deploy/.env
#
# Then: docker compose -f deploy/docker-compose.yaml --env-file deploy/.env up -d

# ---- StateBoard image ------------------------------------------------------
# Pin to a tagged release for production. `latest` tracks main.
STATEBOARD_IMAGE=ghcr.io/saschb2b/stateboard:latest

# Port the host exposes (the container always listens on 3000 internally).
STATEBOARD_PORT=3000

# Public URL the app reaches itself at, including scheme. Must match the
# Valid redirect URI configured on the Keycloak client (which StateBoard
# always registers as <BASE_URL>/api/auth/callback/keycloak).
STATEBOARD_BASE_URL=https://stateboard.example.com

# 32-byte random secret for session cookies. Stable across restarts and
# replicas. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me

# ---- Postgres --------------------------------------------------------------
# Credentials for the bundled Postgres container. Only used inside the
# compose network; the DB is not exposed to the host.
POSTGRES_USER=stateboard
POSTGRES_PASSWORD=replace-me-with-openssl-rand-base64-16
POSTGRES_DB=stateboard

# ---- Your existing Keycloak (or any OIDC provider) -------------------------
# Realm URL — no trailing slash. StateBoard discovers everything else
# from <issuer>/.well-known/openid-configuration.
KEYCLOAK_ISSUER=https://keycloak.example.com/realms/acme
KEYCLOAK_CLIENT_ID=stateboard
KEYCLOAK_CLIENT_SECRET=replace-me

# Optional: comma-separated email-domain allowlist. Empty = any user the
# IdP lets through.
# STATEBOARD_ALLOWED_EMAIL_DOMAINS=acme.com,acme.de

# Role assigned to non-first sign-ins. owner | editor | viewer.
STATEBOARD_DEFAULT_ROLE=editor
